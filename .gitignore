# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Keep the workspace lockfile: Studio and the localization CLI are executables.

# These are backup files generated by rustfmt
**/*.rs.bk

# Devcel Unity Importer — build artifacts placed by build-all-windows.ps1
# Commit .meta files to preserve GUIDs; exclude generated native binaries.
importers/unity/Plugins/**/*.dll
importers/unity/Plugins/**/*.dylib
importers/unity/Plugins/**/*.so
importers/unity/Tools~/devcel
importers/unity/Tools~/devcel.exe

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/



# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build output directories
devcel-out/
build-output/

# Local code-generation output used by the runtime export examples.
# Do not ignore generated/ globally: Studio catalogs
# are checked-in build/distribution inputs, as are the sample runtime JSON files.
/generated/

# Timestamped output when build-all-windows.ps1 targets the repository root.
/Build_[0-9]*/

# Devcel import state is local; the shared import configuration is source data.
**/.devcel/*
!**/.devcel/devcel.import.json
*.devcel-state.json
*.devcel-owner.json
*.devcel-lock

# Interrupted atomic saves and legacy write-lock sidecars (not arbitrary *.tmp).
.devcel-write-????????????????.tmp
.*.table.toml.devcel-write.lock
.*.interface.toml.devcel-write.lock

# Godot editor/import caches, export credentials, and temporary resource saves.
# Keep project.godot, export_presets.cfg, *.uid, and resource import settings.
.godot/
export_credentials.cfg
*.tscn.tmp
*.tres.tmp
*.godot.tmp

# Godot CLI staging and the documented local PCK export destination.
/importers/godot/addons/devcel/bin/
/importers/godot/build/

# Cocos users install the already-compiled editor extension; these are release sources.
!importers/cocos/dist/
!importers/cocos/dist/**

# Local CI/release staging
/release-assets/
/release-importers/
/release-reports/
/release-downloads/
/release-publish/
/native-review-artifacts/
/devcel-studio/src-tauri/bundled-cli/
/devcel-studio/src-tauri/.bundled-cli.conf.json

# Python regression and release tooling caches
__pycache__/
*.py[cod]

# Regenerated from pinned dependencies and authenticated license inputs.
/third-party/generated/
/devcel-studio/public/legal/THIRD-PARTY-NOTICES.txt

/importers/unity/Editor/NativeRequirements.json
